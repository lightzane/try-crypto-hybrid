{
  "compilerOptions": {
    // These 2 are required to enable type Uint8Array<ArrayBuffer>
    "target": "esnext",
    "moduleResolution": "node",

    // This is required to enable dynamic import() syntax (e.g. `import('node:fs')`)
    "module": "esnext",

    "esModuleInterop": true,
    "noEmitOnError": true,
    "removeComments": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "~/*": ["public/*"]
    }
  }
}
